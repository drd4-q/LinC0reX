#!/system/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# lindroid - start the Linux chroot on this phone and hand it the display.
#
# Everything here is runtime state that a reboot destroys: the bind mounts, the
# udev database, and the two services that have to be stopped before Linux can
# take the panel. Re-running this script rebuilds all of it, so it is safe to
# run after any reboot.
#
#   lindroid              interactive shell in the chroot
#   lindroid shell        same
#   lindroid status       who holds the display right now
#   lindroid test         give the panel to Linux, show colour bars
#   lindroid weston       give the panel to Linux, run weston
#   lindroid back         give the panel back to Android
#   lindroid run <cmd>    run one command in the chroot
#
# Root is required; the script re-executes itself under su if it has to.
#
# Keep in sync with tools/panel.sh in the lindroid-kernel repo, which does the
# same handover from the adb side.

ROOTFS=/data/lindroid/droot
BINDIR=/data/lindroid/bin
CARD0=/dev/dri/card0

# The two services that hold the panel. SurfaceFlinger is the obvious one, but
# the Qualcomm composer HAL opens card0 itself and is what actually has to go:
# with only SurfaceFlinger stopped, composer-servic keeps six descriptors on
# the card and nothing else can take DRM master.
SF=surfaceflinger
COMPOSER=vendor.qti.hardware.display.composer

say()  { echo "== $*"; }
warn() { echo "!! $*" >&2; }

# --- privilege -------------------------------------------------------------

if [ "$(id -u)" != 0 ]; then
	args=""
	for a in "$@"; do
		args="$args '$a'"
	done
	exec su -c "sh $0$args"
fi

# --- runtime state ---------------------------------------------------------

# Write one udev database entry, keyed c<major>:<minor>.
#
# The c prefix is not cosmetic. systemd keys its udev database by
# "c<major>:<minor>" for character devices; "n<major>:<minor>" is the old
# udev-only name and this libudev does not consult it. An entry under the n
# name is silently ignored, which is maddening to debug: DEVNAME still comes
# back, because systemd derives that from the sysfs uevent file, so the entry
# looks like it half-worked. Only ID_PATH, ID_SEAT, USEC_INITIALIZED and the
# I: marker go missing.
#
# That last part is why the input devices were skipped. libinput drops any
# event* node whose udev_device_get_is_initialized() is false, and the I:
# record is the only thing that sets it.
udev_entry() {
	local syspath=$1 devname=$2 subsystem=$3 devtype=$4
	local major=$5 minor=$6
	shift 6

	# Connectors and other non-device nodes under /sys/class match the
	# globs below but carry no major/minor. Without this they produce a
	# stray "n:" file.
	if [ -z "$major" ] || [ -z "$minor" ] || [ -z "$devname" ]; then
		return 0
	fi

	mkdir -p "$ROOTFS/run/udev/data"
	{
		echo "E:DEVPATH=${syspath#/sys}"
		echo "E:DEVNAME=/dev/$devname"
		[ -n "$devtype" ] && echo "E:DEVTYPE=$devtype"
		echo "E:MAJOR=$major"
		echo "E:MINOR=$minor"
		echo "E:SUBSYSTEM=$subsystem"
		echo "E:USEC_INITIALIZED=1000000000"
		for kv in "$@"; do
			echo "E:$kv"
		done
		echo "G:seat"
		# systemd's "device is configured" marker. libinput skips any
		# event* node without it, logging "skip unconfigured input
		# device", and weston then refuses to start with no input at all.
		echo "I:1000000000"
	} > "$ROOTFS/run/udev/data/c$major:$minor"
}

# DRM nodes. Without DEVNAME in the database, libdrm's device list is empty and
# weston reports "no drm device found" for a card it can plainly open.
setup_drm_udev() {
	local d
	for d in /sys/class/drm/card*; do
		[ -e "$d/uevent" ] || continue
		udev_entry "$(readlink -f "$d" 2>/dev/null)" \
			"dri/$(sed -n 's/^DEVNAME=dri\///p' "$d/uevent")" \
			drm drm_minor \
			"$(sed -n 's/^MAJOR=//p' "$d/uevent")" \
			"$(sed -n 's/^MINOR=//p' "$d/uevent")" \
			"ID_PATH=platform-lindroid"
	done
}

# Input nodes. weston refuses to start without input devices, and it finds
# them through libinput's udev enumeration, so ID_INPUT and ID_SEAT have to be
# present. Android's ueventd emits neither.
#
# Classification is from the kernel device name and whether the device has any
# absolute axes, which is enough to tell the touchscreen from the keys without
# pulling in udev's hwdb.
setup_input_udev() {
	local e name abs
	for e in /sys/class/input/event*; do
		[ -e "$e/uevent" ] || continue
		name=$(cat "$e/device/name" 2>/dev/null)
		abs=$(cat "$e/device/capabilities/abs" 2>/dev/null | tr -d ' ')

		set -- "ID_INPUT=1" "ID_SEAT=seat0" "ID_INPUT_TOUCHSCREEN=0"
		case "$name" in
		*jack*|*Jack*)
			set -- "ID_INPUT=1" "ID_SEAT=seat0" "ID_INPUT_SWITCH=1" ;;
		esac
		if [ -n "$abs" ]; then
			# A real digitiser reports the multitouch axes in slot
			# range. fts_ts does; the uinput fakes do not.
			case "$abs" in
			*[3-9]*)
				set -- "ID_INPUT=1" "ID_SEAT=seat0" \
				      "ID_INPUT_TOUCHSCREEN=1" \
				      "ID_INPUT_TOUCHPAD=0" ;;
			esac
		fi

		udev_entry "$(readlink -f "$e" 2>/dev/null)" \
			"$(sed -n 's|^DEVNAME=||p' "$e/uevent")" \
			input "" \
			"$(sed -n 's/^MAJOR=//p' "$e/uevent")" \
			"$(sed -n 's/^MINOR=//p' "$e/uevent")" \
			"$@" "ID_PATH=platform-lindroid-$name"
	done
}

setup_mounts() {
	mkdir -p "$MOUNTPOINT" "$ROOTFS" 2>/dev/null

	# Idempotent: only mount what is not already there.
	grep -q " $ROOTFS/proc " /proc/self/mounts 2>/dev/null ||
		mount -t proc proc "$ROOTFS/proc" 2>/dev/null
	# rbind, not bind: a plain bind does not carry submounts, so devpts
	# stays absent in the chroot and weston-terminal dies with "failed to
	# fork and create pty".
	grep -q " $ROOTFS/dev " /proc/self/mounts 2>/dev/null ||
		mount -o rbind /dev "$ROOTFS/dev" 2>/dev/null
	grep -q " $ROOTFS/sys " /proc/self/mounts 2>/dev/null ||
		mount -o rbind /sys "$ROOTFS/sys" 2>/dev/null

	setup_drm_udev
	setup_input_udev
}

# Which processes have card0 open right now.
#
# Done with a single ls rather than a readlink per descriptor: Android runs
# enough processes and descriptors that the shell loop takes minutes, which
# reads as the device hanging.
holders() {
	ls -l /proc/*/fd/* 2>/dev/null |
	grep 'dri/card0' |
	sed -n 's|.*\(/proc/[0-9]*\)/fd/[0-9]*.*|\1|p' |
	sort -u |
	while read -r d; do
		p=${d#/proc/}
		[ -r "/proc/$p/comm" ] && cat "/proc/$p/comm" 2>/dev/null
	done | sort -u
}

# Stop the display owners and wait for the card to actually be free.
release_panel() {
	say "stopping the display owners"
	setprop ctl.stop "$SF" 2>/dev/null
	setprop ctl.stop "$COMPOSER" 2>/dev/null

	local i=0
	while [ $i -lt 20 ]; do
		[ -z "$(holders)" ] && break
		sleep 1
		i=$((i + 1))
	done
	if [ -n "$(holders)" ]; then
		warn "something still holds $CARD0 after ${i}s:"
		holders | sed 's/^/  /'
		return 1
	fi
	say "$CARD0 is free"
	return 0
}

# Composer first, SurfaceFlinger second. The other order leaves SurfaceFlinger
# starting against a display nothing owns.
restore_panel() {
	say "stopping Linux from the display"
	pkill -f kmsclaim 2>/dev/null
	pkill -f weston 2>/dev/null
	sleep 1

	say "restarting the display owners"
	setprop ctl.start "$COMPOSER" 2>/dev/null
	sleep 1
	setprop ctl.start "$SF" 2>/dev/null
	sleep 2
	status
}

status() {
	say "services"
	echo "  surfaceflinger ................ $(getprop init.svc.$SF)"
	echo "  display composer .............. $(getprop init.svc.$COMPOSER)"

	say "panel"
	if [ -e /sys/class/drm/card0-DSI-1/enabled ]; then
		echo "  card0-DSI-1/status ........... $(cat /sys/class/drm/card0-DSI-1/status 2>/dev/null)"
		echo "  card0-DSI-1/enabled .......... $(cat /sys/class/drm/card0-DSI-1/enabled 2>/dev/null)"
	else
		echo "  (no DSI connector on card0)"
	fi

	say "processes holding $CARD0"
	local h
	h=$(holders)
	[ -z "$h" ] && echo "  (none)" || echo "$h" | sed 's/^/  /'
}

need_chroot() {
	if [ ! -x "$ROOTFS/usr/bin/weston" ]; then
		warn "no chroot at $ROOTFS"
		warn "build it on a PC with tools/fetchdeb.py, push the tarball"
		warn "to /data/lindroid/ and unpack it there"
		exit 1
	fi
}

# --- commands --------------------------------------------------------------

cmd_status() {
	setup_mounts
	status
}

cmd_shell() {
	setup_mounts
	need_chroot
	say "chroot ready. Android is still in charge of the display."
	echo "  to take the panel:  $BINDIR/lindroid test   (or: weston)"
	echo "  to give it back:    $BINDIR/lindroid back"
	exec chroot "$ROOTFS" /bin/sh -c \
		"export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
		 exec /bin/sh -l"
}

cmd_run() {
	setup_mounts
	need_chroot
	[ $# -eq 0 ] && { echo 'usage: lindroid run <command>' >&2; exit 2; }
	exec chroot "$ROOTFS" /bin/sh -c \
		"export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
		 exec \"\$@\"" sh "$@"
}

cmd_test() {
	setup_mounts
	need_chroot
	release_panel || exit 1
	# kmsclaim stays in the foreground on purpose: DRM master is released
	# when its fd closes, so its lifetime is what keeps the panel ours.
	say "colour bars incoming. '$BINDIR/lindroid back' to return it."
	exec chroot "$ROOTFS" /usr/bin/kmsclaim
}

cmd_weston() {
	setup_mounts
	need_chroot
	release_panel || exit 1

	# Everything goes in weston.ini, not on the command line. weston hands
	# its whole argv to the shell module, and both desktop-shell and
	# kiosk-shell abort with "fatal: unhandled option" on anything they do
	# not recognise - including --renderer, which is exactly what has to be
	# set here.
	local ini=$ROOTFS/etc/xdg/weston/weston.ini
	if [ ! -f "$ini" ]; then
		mkdir -p "$(dirname "$ini")"
		cat > "$ini" <<-'EOF'
		[core]
		backend=drm-backend.so
		drm-device=card0
		# pixman, not gl. The DRM backend path goes through GBM, and
		# the only mesa driver there is kms_swrast, which wants DRI_DRI2.
		# SDE does not provide that, so every DRI driver fails and EGL
		# never comes up. pixman needs no GPU at all.
		renderer=pixman
		shell=kiosk-shell.so
		EOF
	fi

	# fmtshim.so is only needed because SDE advertises a format twice and
	# weston 10 asserts on it. See tools/fmtshim.c.
	local preload=""
	if [ -f "$ROOTFS/usr/lib/fmtshim.so" ]; then
		preload="export LD_PRELOAD=/usr/lib/fmtshim.so"
	else
		warn "no /usr/lib/fmtshim.so - weston will abort on duplicate formats"
	fi

	say "starting weston. '$BINDIR/lindroid back' to return the display."
	( sleep 8
	  sock=$(ls "$ROOTFS"/run/user/0/wayland-* 2>/dev/null |
	         grep -v '\.lock$' | head -1)
	  if [ -n "$sock" ]; then
		say "wayland socket: ${sock##*/}"
		say "run a client with:  $BINDIR/lindroid run env WAYLAND_DISPLAY=${sock##*/} weston-terminal"
	  fi ) &

	exec chroot "$ROOTFS" /bin/sh -c \
		"export PATH=/usr/bin:/bin
		 export XDG_RUNTIME_DIR=/run/user/0
		 $preload
		 mkdir -p /run/user/0 && chmod 700 /run/user/0
		 exec /usr/bin/weston"
}

cmd_back() {
	restore_panel
}

case "${1:-shell}" in
shell)   shift; cmd_shell "$@" ;;
run)     shift; cmd_run "$@" ;;
test)    cmd_test ;;
weston)  cmd_weston ;;
back)    cmd_back ;;
status)  cmd_status ;;
-h|--help|help)
	sed -n '3,22p' "$0" | sed 's/^# \?//'
	;;
*)
	warn "unknown command: $1"
	cmd_status
	exit 2
	;;
esac
