#!/system/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# lindroid - start the Linux chroot on this phone and hand it the display.
#
# Two phases, always in this order:
#
#   1. setup  mount everything the chroot needs, rebuild the udev database,
#             make sure the loader can find what it needs. All of this is
#             runtime state that a reboot destroys.
#   2. action take the panel from Android, or give it back, or run something.
#
# Never the other way round. A compositor started against a half-mounted
# chroot fails in ways that look like driver bugs: no /dev/dri, no udev
# database, no pty, no fonts.
#
#   lindroid              interactive shell, Android still owns the display
#   lindroid status       who holds the display right now
#   lindroid test         colour bars on the panel
#   lindroid weston       weston on the panel
#   lindroid terminal     weston + weston-terminal
#   lindroid flower       weston + a client that needs no fonts
#   lindroid lind         lind, our own compositor, on the proven path
#   lindroid demo [secs]  lind plus a client, one command, for a fresh boot
#   lindroid home         just the desktop: lind alone, so the home screen shows
#   lindroid scansync [s] same, but the frame is written band by band in step
#                         with the scan beam instead of being page flipped
#   lindroid client <c>   run one Wayland client against a running weston
#   lindroid back         give the panel back to Android
#   lindroid run <cmd>    run one command in the chroot
#
# Root is required; the script re-executes itself under su if it has to.

ROOTFS=/data/lindroid/droot
BINDIR=/data/lindroid/bin
MOUNTPOINT=/data/lindroid
CARD0=/dev/dri/card0

# The two services that hold the panel. SurfaceFlinger is the obvious one, but
# the Qualcomm composer HAL opens card0 itself and is what actually has to go:
# with only SurfaceFlinger stopped, composer-servic keeps six descriptors on
# the card and nothing else can take DRM master.
SF=surfaceflinger
COMPOSER=vendor.qti.hardware.display.composer

say()  { echo "== $*"; }
warn() { echo "!! $*" >&2; }
die()  { warn "$*"; exit 1; }

# --- privilege -------------------------------------------------------------

if [ "$(id -u)" != 0 ]; then
	args=""
	for a in "$@"; do
		args="$args '$a'"
	done
	exec su -c "sh $0$args"
fi

# --- phase 1: runtime state ------------------------------------------------

mounted() { grep -q " $ROOTFS/$1 " /proc/self/mounts 2>/dev/null; }

# Write one udev database entry, keyed c<major>:<minor>.
#
# The c prefix is not cosmetic. systemd keys its udev database by
# "c<major>:<minor>" for character devices; "n<major>:<minor>" is the old
# udev-only name and this libudev does not consult it. An entry under the n
# name is silently ignored, which is maddening to debug: DEVNAME still comes
# back, because systemd derives that from the sysfs uevent file, so the entry
# looks like it half-worked. Only ID_PATH, ID_SEAT, USEC_INITIALIZED and the
# I: marker go missing.
#
# That last part is why input devices were skipped. libinput drops any event*
# node whose udev_device_get_is_initialized() is false, and the I: record is
# the only thing that sets it.
udev_entry() {
	local syspath=$1 devname=$2 subsystem=$3 devtype=$4
	local major=$5 minor=$6
	shift 6

	# Connectors and other non-device nodes under /sys/class match the
	# globs below but carry no major/minor.
	[ -n "$major" ] && [ -n "$minor" ] && [ -n "$devname" ] || return 0

	mkdir -p "$ROOTFS/run/udev/data"
	{
		echo "E:DEVPATH=${syspath#/sys}"
		echo "E:DEVNAME=/dev/$devname"
		[ -n "$devtype" ] && echo "E:DEVTYPE=$devtype"
		echo "E:MAJOR=$major"
		echo "E:MINOR=$minor"
		echo "E:SUBSYSTEM=$subsystem"
		echo "E:USEC_INITIALIZED=1000000000"
		for kv in "$@"; do
			echo "E:$kv"
		done
		echo "G:seat"
		echo "I:1000000000"
	} > "$ROOTFS/run/udev/data/c$major:$minor"
}

setup_drm_udev() {
	local d
	for d in /sys/class/drm/card*; do
		[ -e "$d/uevent" ] || continue
		udev_entry "$(readlink -f "$d" 2>/dev/null)" \
			"dri/$(sed -n 's/^DEVNAME=dri\///p' "$d/uevent")" \
			drm drm_minor \
			"$(sed -n 's/^MAJOR=//p' "$d/uevent")" \
			"$(sed -n 's/^MINOR=//p' "$d/uevent")" \
			"ID_PATH=platform-lindroid"
	done
}

# Classification is from the kernel device name and by whether the device has
# absolute axes, which separates the touchscreen from the keys without pulling
# in udev's hwdb.
setup_input_udev() {
	local e name abs
	for e in /sys/class/input/event*; do
		[ -e "$e/uevent" ] || continue
		name=$(cat "$e/device/name" 2>/dev/null)
		abs=$(cat "$e/device/capabilities/abs" 2>/dev/null | tr -d ' ')

		set -- "ID_INPUT=1" "ID_SEAT=seat0" "ID_INPUT_TOUCHSCREEN=0"
		case "$name" in
		*jack*|*Jack*)
			set -- "ID_INPUT=1" "ID_SEAT=seat0" "ID_INPUT_SWITCH=1" ;;
		esac
		# A real digitiser reports multitouch axes in the slot range.
		# fts_ts does; the uinput fakes do not.
		case "$abs" in
		*[3-9]*)
			set -- "ID_INPUT=1" "ID_SEAT=seat0" \
			      "ID_INPUT_TOUCHSCREEN=1" "ID_INPUT_TOUCHPAD=0" ;;
		esac

		udev_entry "$(readlink -f "$e" 2>/dev/null)" \
			"$(sed -n 's|^DEVNAME=||p' "$e/uevent")" \
			input "" \
			"$(sed -n 's/^MAJOR=//p' "$e/uevent")" \
			"$(sed -n 's/^MINOR=//p' "$e/uevent")" \
			"$@" "ID_PATH=platform-lindroid-$name"
	done
}

# Everything that has to be true before any client or compositor is started.
setup_env() {
	mkdir -p "$MOUNTPOINT" "$ROOTFS" 2>/dev/null

	# rbind, not bind: a plain bind does not carry submounts, so devpts
	# stays absent in the chroot and anything that opens a pty fails with
	# "No such device".
	mounted proc  || mount -t proc proc "$ROOTFS/proc" 2>/dev/null
	mounted dev   || mount -o rbind /dev "$ROOTFS/dev" 2>/dev/null
	mounted sys   || mount -o rbind /sys "$ROOTFS/sys" 2>/dev/null

	# A separate devpts instance, in case the rbind above did not bring one
	# along. Without it weston-terminal cannot fork a pty.
	if ! grep -q " $ROOTFS/dev/pts " /proc/self/mounts 2>/dev/null; then
		mkdir -p "$ROOTFS/dev/pts" 2>/dev/null
		mount -t devpts devpts "$ROOTFS/dev/pts" 2>/dev/null
	fi

	setup_drm_udev
	setup_input_udev

	# Font cache. Without the fontconfig package there is no fc-cache, so
	# the cache is never built and every string renders as nothing at all -
	# which looks exactly like a compositor that draws no text.
	if [ -x "$ROOTFS/usr/bin/fc-cache" ]; then
		chroot "$ROOTFS" /bin/sh -c \
			'export PATH=/usr/bin:/bin; fc-cache -f' >/dev/null 2>&1
	fi

	[ -d "$ROOTFS/usr/bin" ] || die "no chroot at $ROOTFS"
}

# --- phase 2: actions ------------------------------------------------------

# Which processes have card0 open. One ls over /proc/*/fd/* rather than a
# readlink per descriptor: the shell loop takes minutes on Android and reads
# as the device hanging.
holders() {
	ls -l /proc/*/fd/* 2>/dev/null |
	grep 'dri/card0' |
	sed -n 's|.*\(/proc/[0-9]*\)/fd/[0-9]*.*|\1|p' |
	sort -u |
	while read -r d; do
		p=${d#/proc/}
		[ -r "/proc/$p/comm" ] && cat "/proc/$p/comm" 2>/dev/null
	done | sort -u
}

release_panel() {
	say "stopping the display owners"
	setprop ctl.stop "$SF" 2>/dev/null
	setprop ctl.stop "$COMPOSER" 2>/dev/null

	local i=0
	while [ $i -lt 20 ]; do
		[ -z "$(holders)" ] && break
		sleep 1
		i=$((i + 1))
	done
	[ -n "$(holders)" ] && {
		warn "something still holds $CARD0 after ${i}s:"
		holders | sed 's/^/  /'
		return 1
	}
	say "$CARD0 is free"
}

# Composer first, SurfaceFlinger second. The other order leaves SurfaceFlinger
# starting against a display nothing owns.
# Take the chroot mounts back off, deepest first.
#
# Leaving them was not harmless. An rbind of /dev brings every submount with it,
# which on Android includes the cgroup v1 hierarchies - /dev/blkio, /dev/cpuctl,
# /dev/cpuset - and those stayed mounted into the chroot after the compositor was
# gone: 22 mounts, ours, with nothing using them.
#
# Lazy, because the phone reboots constantly and a busy mount should not be able
# to hold the handback open. setup_env puts them back on the next run.
# Take down only what we created ourselves.
#
# This was 22 mounts and it broke the phone. An rbind of /dev carries every
# submount with it, which on Android includes the cgroup v1 hierarchies, and
# those live in a shared peer group: umounting the copy inside the chroot sent
# an unmount message to the peer and took Android's own /dev/cpuctl, /dev/blkio
# and /dev/cpuset with it. init then could not get a process context and refused
# to start surfaceflinger at all, so the phone had no display until a reboot.
#
# So: only $ROOTFS/proc, which is a fresh proc mount belonging to us and to
# nothing else. /dev and /sys are left alone - they have been mounted for the
# whole project without harm, they are re-created by setup_env anyway, and the
# upside of removing them is far smaller than the downside of getting it wrong.
#
# A guard on top: never unmount a cgroup, whatever the path.
unmount_env() {
	local m left type

	for m in "$ROOTFS/proc"; do
		if mount 2>/dev/null | grep -q " $m "; then
			umount -l "$m" </dev/null 2>/dev/null
		fi
	done

	# Belt and braces: report anything we did not expect, rather than act.
	left=$(mount 2>/dev/null | awk '{print $3}' |
	       grep "^$ROOTFS/dev/\|^$ROOTFS/sys/" | wc -l)
	if [ "$left" -gt 0 ]; then
		say "chroot/proc размонтирован; /dev и /sys оставлены (несут общие монтирования Android)"
		:
	fi

	for m in $(mount 2>/dev/null | awk '{print $3}' | grep "^$ROOTFS"); do
		type=$(mount 2>/dev/null | grep " $m " | awk '{print $5}')
		if [ "$type" = cgroup ]; then
			warn "НЕ трогаю cgroup-монтирование: $m"
		fi
	done
}

restore_panel() {
	say "stopping Linux from the display"
	# -x, exact name. Without it "pkill lind" also matches lindroid - this
	# script - and the handback killed itself on its first line. That is why
	# back had been stopping right after its first message: the chroot stayed
	# mounted and Android was never properly restarted, which is very
	# likely what left touch dead on the phone afterwards.
	pkill -x kmsclaim 2>/dev/null
	pkill -x weston 2>/dev/null
	pkill -x weston-terminal 2>/dev/null
	pkill -x lindtest 2>/dev/null
	pkill -x lind 2>/dev/null
	sleep 1

	# The compositor must be gone before the panel is handed back, or the
	# first SetCrtc loses the race with it and reads as a driver fault.
	unmount_env

	say "restarting the display owners"
	setprop ctl.start "$COMPOSER" 2>/dev/null
	sleep 1
	setprop ctl.start "$SF" 2>/dev/null
	sleep 2

	local sf
	sf=$(getprop init.svc."$SF")
	if [ "$sf" = running ]; then
		cat <<-'NOTE'
		ВНИМАНИЕ: тач на Android после возврата может не заработать сразу.
		Он не завис - устройство держит system_server, это проверено.
		Но конвейер вводаAndroid переживает остановку SurfaceFlinger не
		всегда, и восстанавливается перезагрузкой: lindroid reboot.
		Если тач заработал сам - всё в порядке, сообщать не нужно.
		NOTE
	else
		warn "$SF не поднялся: $sf"
	fi
}

status() {
	say "services"
	echo "  surfaceflinger ................ $(getprop init.svc.$SF)"
	echo "  display composer .............. $(getprop init.svc.$COMPOSER)"

	say "panel"
	if [ -e /sys/class/drm/card0-DSI-1/enabled ]; then
		echo "  card0-DSI-1/status ........... $(cat /sys/class/drm/card0-DSI-1/status 2>/dev/null)"
		echo "  card0-DSI-1/enabled .......... $(cat /sys/class/drm/card0-DSI-1/enabled 2>/dev/null)"
	else
		echo "  (no DSI connector on card0)"
	fi

	say "processes holding $CARD0"
	local h
	h=$(holders)
	[ -z "$h" ] && echo "  (none)" || echo "$h" | sed 's/^/  /'

	say "wayland sockets"
	wayland_socket | sed 's/^/  /' || echo "  (none)"
}

# Write a launcher into the chroot, so the environment is identical every time
# a client is started. Body is read from stdin.
#
# This exists mainly to dodge a quoting problem: a chroot-side script needs a
# shebang the chroot can resolve, and /system/bin/sh does not exist in there.
write_runner() {
	local name=$1
	mkdir -p "$ROOTFS/usr/bin"
	{
		echo '#!/bin/sh'
		echo 'export PATH=/usr/bin:/bin'
		echo 'export XDG_RUNTIME_DIR=/run/user/0'
		cat
	} > "$ROOTFS/usr/bin/$name"
	chmod 755 "$ROOTFS/usr/bin/$name"
}

# Basename of the running compositor's socket, empty if there is none.
wayland_socket() {
	ls "$ROOTFS"/run/user/0/wayland-* 2>/dev/null |
		grep -v '\.lock$' | head -1
}

weston_ini() {
	local ini=$ROOTFS/etc/xdg/weston/weston.ini
	mkdir -p "$(dirname "$ini")"
	cat > "$ini" <<-'EOF'
	# The key is use-pixman, not renderer. weston 10 reads it from [core];
	# "renderer" is not a recognised key and is silently ignored, leaving
	# the GL renderer in place.
	#
	# pixman, not gl: the DRM backend path goes through GBM, where the only
	# usable mesa driver is kms_swrast and it wants DRI_DRI2. SDE does not
	# implement that, so every DRI driver fails. pixman needs no GPU and
	# presents through plain dumb buffers.
	[core]
	backend=drm-backend.so
	drm-device=card0
	use-pixman=true
	shell=kiosk-shell.so
	EOF
}

start_weston() {
	weston_ini

	# fmtshim.so is only needed because SDE advertises a format twice and
	# weston 10 asserts on it. See tools/fmtshim.c.
	local preload=""
	if [ -f "$ROOTFS/usr/lib/fmtshim.so" ]; then
		preload="export LD_PRELOAD=/usr/lib/fmtshim.so"
	else
		warn "no /usr/lib/fmtshim.so - weston will abort on duplicate formats"
	fi

	write_runner weston-run <<EOF
export WESTON_CONFIG_FILE=/etc/xdg/weston/weston.ini
$preload
rm -f /run/user/0/wayland-*
mkdir -p /run/user/0 && chmod 700 /run/user/0
exec /usr/bin/weston
EOF

	say "starting weston"
	setsid chroot "$ROOTFS" /usr/bin/weston-run \
		> "$MOUNTPOINT/weston.log" 2>&1 < /dev/null &

	# Wait for the socket rather than sleeping a fixed amount.
	local i=0 sock=""
	while [ $i -lt 15 ]; do
		sock=$(wayland_socket)
		[ -n "$sock" ] && break
		sleep 1
		i=$((i + 1))
	done
	if [ -n "$sock" ]; then
		say "wayland socket: ${sock##*/}"
		say "a client can now connect:  WAYLAND_DISPLAY=${sock##*/}"
	else
		warn "weston did not create a socket; see $MOUNTPOINT/weston.log"
	fi
}

run_client() {
	local bin=$1 name=$2
	shift 2
	[ -x "$ROOTFS/usr/bin/$bin" ] || die "$bin is not installed"

	write_runner "$name" <<EOF
export SHELL=/bin/sh
export TERM=xterm
export WAYLAND_DISPLAY=\${WAYLAND_DISPLAY:-wayland-1}
exec /usr/bin/$bin $*
EOF

	say "launching $bin"
	setsid chroot "$ROOTFS" "/usr/bin/$name" \
		> "$MOUNTPOINT/$name.log" 2>&1 < /dev/null &
	sleep 3
	tail -2 "$MOUNTPOINT/$name.log" 2>/dev/null | sed 's/^/  /'
}

# --- commands --------------------------------------------------------------

cmd_shell() {
	setup_env
	say "chroot ready. Android still owns the display."
	echo "  take the panel:  $BINDIR/lindroid weston   (or: terminal, flower, test)"
	echo "  give it back:    $BINDIR/lindroid back"
	exec chroot "$ROOTFS" /bin/sh -c \
		'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
		 exec /bin/sh -l'
}

cmd_run() {
	setup_env
	[ $# -gt 0 ] || die 'usage: lindroid run <command>'
	exec chroot "$ROOTFS" /bin/sh -c \
		'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
		 exec "$@"' sh "$@"
}

cmd_test() {
	setup_env
	release_panel || exit 1
	say "colour bars. '$BINDIR/lindroid back' to return the display."
	exec chroot "$ROOTFS" /usr/bin/kmsclaim
}

cmd_weston() {
	setup_env
	release_panel || exit 1
	start_weston
	say "running. '$BINDIR/lindroid back' to return the display."
	say "weston log: $MOUNTPOINT/weston.log"
}

cmd_terminal() {
	setup_env
	release_panel || exit 1
	start_weston
	run_client weston-terminal term-run
}

# The panel can be busy even when both services report stopped, which shows up
# as "SetCrtc: Permission denied" and reads like a driver fault. Wait it out
# rather than pass the problem on.
wait_card_free() {
	local i=0
	while [ $i -lt 10 ]; do
		[ -z "$(holders)" ] && return 0
		sleep 1
		i=$((i + 1))
	done
	warn "$CARD0 всё ещё занят:"
	holders | sed 's/^/  /'
	return 1
}

# Extra environment for lind, exported inside the chroot. chroot does not carry
# the caller's environment, so setting LIND_SCANSYNC outside would do nothing:
# the compositor has to be launched through a runner script to see it.
LIND_ENV=""

start_lind() {
	[ -x "$ROOTFS/usr/bin/lind" ] || die "lind не установлен в chroot"
	rm -f "$ROOTFS"/run/user/0/wayland-* 2>/dev/null
	say "запускаю lind"

	mkdir -p "$ROOTFS/usr/bin"
	cat > "$ROOTFS/usr/bin/lind-launch" <<EOF
#!/bin/sh
export PATH=/usr/bin:/bin
export XDG_RUNTIME_DIR=/run/user/0
export WAYLAND_DISPLAY=wayland-0
$LIND_ENV
exec /usr/bin/lind
EOF
	chmod 755 "$ROOTFS/usr/bin/lind-launch"

	setsid chroot "$ROOTFS" /usr/bin/lind-launch \
		> "$MOUNTPOINT/lind.log" 2>&1 < /dev/null &

	local i=0
	while [ $i -lt 10 ]; do
		[ -S "$ROOTFS/run/user/0/wayland-0" ] && break
		sleep 1
		i=$((i + 1))
	done
	if [ ! -S "$ROOTFS/run/user/0/wayland-0" ]; then
		warn "lind не создал сокет; лог:"
		tail -5 "$MOUNTPOINT/lind.log" 2>/dev/null | sed 's/^/  /'
		return 1
	fi
	return 0
}

cmd_lind() {
	setup_env
	release_panel || exit 1
	wait_card_free || exit 1
	start_lind || exit 1
	say "lind слушает $ROOTFS/run/user/0/wayland-0"
	say "лог: $MOUNTPOINT/lind.log"
	say "клиент: $BINDIR/lindroid client ..."
}

# The desktop on its own: no client, so the compositor draws its home screen.
# Demo starts a client as well, which covers the home screen - deliberately, so
# that this is the way to see it.
cmd_home() {
	setup_env
	release_panel || exit 1
	wait_card_free || exit 1
	start_lind || exit 1
	say "домашний экран, окно приложения не запущено"
	say "тап по плитке запускает приложение из \$ROOTFS/usr/share/lindroid/apps"
	say "лог: $MOUNTPOINT/lind.log"
	say "вернуть: $BINDIR/lindroid back"
}

# The banded-presentation run: same demo, but lind writes the frame where it is
# shown, one band at a time, timed against the beam, instead of page flipping.
cmd_scansync() {
	LIND_ENV="export LIND_SCANSYNC=1"
	cmd_demo "$@"
}

# Everything in one command, because the phone reboots often enough that
# doing it by hand is a dozen steps and any of them can be the stale one.
cmd_demo() {
	setup_env
	release_panel || exit 1
	wait_card_free || exit 1
	start_lind || exit 1

	[ -x "$ROOTFS/usr/bin/lindtest" ] || die "lindtest не установлен"
	say "запускаю lindtest - полоса пойдёт сверху вниз"

	# A client needs the runtime dir and socket name in its environment.
	# lind sets the first for itself with setenv, which does nothing for
	# anything else launched beside it.
	write_runner lindtest-run <<-EOF
	export XDG_RUNTIME_DIR=/run/user/0
	export WAYLAND_DISPLAY=wayland-0
	exec /usr/bin/lindtest ${1:-60}
	EOF

	setsid chroot "$ROOTFS" /usr/bin/lindtest-run \
		> "$MOUNTPOINT/lindtest.log" 2>&1 < /dev/null &

	sleep 4
	say "готово. полоса движется, андроид выключен из панели."
	say "вернуть: $BINDIR/lindroid back"
	tail -3 "$MOUNTPOINT/lindtest.log" 2>/dev/null | sed 's/^/  /'
}

cmd_flower() {
	setup_env
	release_panel || exit 1
	start_weston
	run_client weston-flower flower-run
}

cmd_client() {
	setup_env
	[ $# -gt 0 ] || die 'usage: lindroid client <command> [args...]'
	local name=${1##*/}
	run_client "$name" "client-$name"
}

cmd_back() {
	restore_panel
	status
}

# Android's input pipeline does not always come back from losing
# SurfaceFlinger. This is the reliable way out, and it is offered rather than
# done on its own: rebooting a phone unasked is not ours to decide.
cmd_reboot() {
	say "перезагружаю телефон"
	sync
	reboot
}

cmd_status() {
	setup_env
	status
}

case "${1:-shell}" in
shell)   shift; cmd_shell "$@" ;;
run)     shift; cmd_run "$@" ;;
test)    cmd_test ;;
weston)  cmd_weston ;;
terminal) cmd_terminal ;;
flower)  cmd_flower ;;
lind)    cmd_lind ;;
demo)    shift; cmd_demo "$@" ;;
home)    cmd_home ;;
scansync) shift; cmd_scansync "$@" ;;
client)  shift; cmd_client "$@" ;;
back)    cmd_back ;;
reboot)  cmd_reboot ;;
status)  cmd_status ;;
-h|--help|help)
	sed -n '4,24p' "$0" | sed 's/^# \?//'
	;;
*)
	warn "unknown command: $1"
	cmd_status
	exit 2
	;;
esac
