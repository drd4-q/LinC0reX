diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index b5be53de7..21248cf8e 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -132,8 +132,12 @@ else
 KBUILD_TARGET   := Image
 endif
 
+# dtbo.img excluded: see arch/arm64/boot/Makefile.  The stock boot.img has no
+# appended DTB and the flashable zip ships the kernel alone, so the image would
+# be built and then thrown away -- while requiring the unavailable "mkdtimg"
+# binary to do it.
 ifeq ($(CONFIG_BUILD_ARM64_DT_OVERLAY),y)
-KBUILD_TARGET   += dtbo.img
+# KBUILD_TARGET += dtbo.img
 endif
 
 # Default target when executing plain make
diff --git a/arch/arm64/boot/Makefile b/arch/arm64/boot/Makefile
index d86ea4caf..f3339507e 100644
--- a/arch/arm64/boot/Makefile
+++ b/arch/arm64/boot/Makefile
@@ -16,7 +16,14 @@
 
 OBJCOPYFLAGS_Image :=-O binary -R .note -R .note.gnu.build-id -R .comment -S
 
-targets := Image Image.bz2 Image.gz Image.lz4 Image.lzma Image.lzo dtbo.img
+# dtbo.img is intentionally not built.
+#
+# The stock boot.img ships no appended DTB and the flashable zip must not carry
+# one, so there is nothing to package.  Building it also needs the external
+# "mkdtimg" binary, which is not present and has no maintained source anymore.
+# Dropping it from the target list keeps the build self-contained and the
+# packaged layout identical to stock.
+targets := Image Image.bz2 Image.gz Image.lz4 Image.lzma Image.lzo
 
 DTBO_OBJS := $(shell find -L $(obj)/dts/ -name \*.dtbo)
 
